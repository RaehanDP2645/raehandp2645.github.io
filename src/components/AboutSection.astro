---
import profile from '../data/profile.json';
---

<section id="about" class="py-12 px-6 md:px-12 bg-slate-50 dark:bg-slate-900">
  <div class="mb-8">
  <h1 class="text-3xl md:text-5xl font-bold text-slate-900 dark:text-white mb-2">
    {profile.bio}
  </h1>
  <p class="text-lg text-slate-600 dark:text-slate-300">
    {profile.subtitle}
  </p>
</div>

<div class="mb-12 max-w-2xl">
  <p class="text-base md:text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
    {profile.about}
  </p>
</div>

<div class="mb-12">
  <h2 class="text-xl md:text-2xl font-semibold text-slate-900 dark:text-white mb-4">
    Prinsip
  </h2>
  <ul class="space-y-2">
    {profile.values.map((value) => (
      <li class="flex items-start gap-3">
        <span class="text-blue-500 mt-1">•</span>
        <span class="text-slate-700 dark:text-slate-300">{value}</span>
      </li>
    ))}
  </ul>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
  {Object.entries(profile.stats).map(([key, value]) => (
    <div class="p-4 bg-white dark:bg-slate-800 rounded-lg shadow hover:shadow-lg transition-shadow duration-300">
      <p class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wide">
        {key}
      </p>
      <p class="text-lg md:text-xl font-bold text-slate-900 dark:text-white mt-2">
        {value}
      </p>
    </div>
  ))}
</div>


</section>