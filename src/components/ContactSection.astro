---
import contact from '../data/contact.json';
---

<section id="contact" class="py-12 px-6 md:px-12 bg-slate-900 dark:bg-slate-950">
  <h2 class="text-2xl md:text-4xl font-bold text-white mb-12">
    Get In Touch
  </h2>

  <div class="flex flex-wrap gap-4">
    {contact.methods.map((item) => (
      <a 
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors duration-300"
      >
        <span class="text-lg">{item.icon}</span>
        <span class="font-medium">{item.label}</span>
      </a>
    ))}
  </div>

  <div class="mt-12 text-center text-slate-400 dark:text-slate-500">
    <p class="text-sm">
      Atau langsung email ke: <a href="mailto:hello@raehan.dev" class="text-blue-400 hover:underline">hello@raehan.dev</a>
    </p>
  </div>
</section>